# Dexter configuration — copy to `.env` and fill in real values.
# Never commit `.env`. The MBTA library works without an API key (lower rate
# limit); the Azure OpenAI values are required to run the agent/service.

# --- MBTA ---
# Optional. With a key the rate limit rises to 1000 req/min.
MBTA_API_KEY=
MBTA_BASE_URL=https://api-v3.mbta.com

# --- Azure OpenAI (required for the agent) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT_ROUTER=     # small/fast model for intent + slots

# --- Service ---
DEXTER_HOST=127.0.0.1
DEXTER_PORT=8000
LOG_LEVEL=INFO

# --- Beta web client (optional; off by default) ---
# Serve the static terminal UI (web/index.html) from the brain at GET /.
DEXTER_SERVE_WEB=false
# Shared beta passphrase. When set, /chat requires a matching X-Dexter-Passcode
# header (the web UI prompts for it). Leave blank to disable the gate.
DEXTER_PASSCODE=

# --- Observability (optional; see documents/observability-prd.md) ---
# Enable OpenTelemetry tracing. Local: an Arize Phoenix instance (needs the
# 'tracing-local' extra). Cloud: app.phoenix.arize.com (needs the 'tracing' extra).
DEXTER_TRACING=false
# OTLP endpoint. Blank = local default. For Phoenix Cloud, your project's OTLP URL.
DEXTER_TRACING_ENDPOINT=
# Phoenix Cloud API key (sent as the `api_key` OTLP header). Blank for local.
DEXTER_TRACING_API_KEY=

# --- Azure deploy (optional; for deploy/deploy.py) ---
# The deploy script uses DefaultAzureCredential. If you are not using Azure CLI
# auth, the standard service principal env vars below are the most reliable path.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure resource names / deployment defaults.
# Shared-infra example: point the app, CAE, and ACR at the same RG unless your
# environment or registry live elsewhere.
AZURE_RESOURCE_GROUP=rg-dealsignal-prod
AZURE_LOCATION=eastus2
AZURE_CONTAINERAPPS_ENV_NAME=dealsignal-env
AZURE_CONTAINERAPPS_ENV_RESOURCE_GROUP=rg-dealsignal-prod
AZURE_CONTAINERAPP_NAME=dexter-beta
AZURE_CONTAINER_REGISTRY_RESOURCE_GROUP=rg-dealsignal-prod
# Optional. Set this to reuse an existing ACR, or leave blank to let the deploy
# script choose a deterministic registry name from the subscription ID.
AZURE_CONTAINER_REGISTRY_NAME=dealsignalacr12345
AZURE_CONTAINER_REPOSITORY=dexter
# Optional. Leave blank to let the deploy script use a UTC timestamp tag.
AZURE_CONTAINER_IMAGE_TAG=
AZURE_CONTAINER_MAX_REPLICAS=1

# Local container build/push tool. Usually just `docker`.
AZURE_DOCKER_EXE=docker
